{
  "name": "FirebaseAuth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "clean": "yarn cache clean",
    "aclean": "cd android && gradlew.bat clean",
    "keystore": "cd android/app && if exist duam-release-key.keystore del /f /q duam-release-key.keystore && keytool -genkeypair -v -keystore duam-release-key.keystore -alias duam-key-alias -keyalg RSA -keysize 2048 -validity 10000 -storepass \"DuamRelease2026!\" -keypass \"DuamRelease2026!\" -dname \"CN=DUAM, OU=DUAM, O=DUAM, L=Istanbul, ST=Istanbul, C=TR\"",
    "release": "npx react-native build-android --mode=release",
    "rbuild": "npm run android -- --mode=\"release\"",
    "build": "npm run aab:build",
    "apk": "cd android && gradlew.bat assembleRelease && cd ..",
    "abb": "cd android && gradlew.bat bundleRelease && cd ..",
    "ins": "npm run apk && adb install -r android/app/build/outputs/apk/release/app-arm64-v8a-release.apk",
    "reset": "cd android && gradlew.bat clean && cd .. && if exist android\\.gradle rmdir /s /q android\\.gradle && if exist android\\build rmdir /s /q android\\build && if exist android\\app\\build rmdir /s /q android\\app\\build"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^19.0.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/firestore": "^27.1.0",
    "@react-native-firebase/storage": "^27.1.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-image-picker": "^8.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-screens": "^4.30.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
